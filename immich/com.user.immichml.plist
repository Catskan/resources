<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.immichml</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/aurel/git/resources/immich/start-immich-ml-agent.sh</string>
    </array>

    <!-- Service permanent : démarre à l'ouverture de session et reste en vie.
         KeepAlive relance le processus s'il s'arrête, quelle qu'en soit la raison
         (crash, OOM, sortie de veille). Sans lui, Immich basculerait silencieusement
         sur le conteneur ML du NAS, qu'on cherche justement à décharger. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Garde-fou anti-boucle : si le démarrage échoue en boucle (uv sync cassé,
         dépôt absent), launchd attend 60 s entre deux tentatives au lieu de saturer
         la machine. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- ~/Library/Logs plutôt que /tmp, que macOS purge au redémarrage. -->
    <key>StandardOutPath</key>
    <string>/Users/aurel/Library/Logs/immichml.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aurel/Library/Logs/immichml.err</string>
</dict>
</plist>
