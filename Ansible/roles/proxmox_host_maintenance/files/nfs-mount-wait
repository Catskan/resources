#!/bin/sh
# Attend qu'un point de montage réseau soit monté, en le relançant lui-même.
# Géré par Ansible — rôle proxmox_host_maintenance. Ne pas éditer à la main.
#
# Pourquoi ce script existe : une unité `.mount` générée depuis /etc/fstab n'a PAS de
# `Restart=`. Si le montage échoue une fois au démarrage — typiquement parce que le
# serveur NFS est joint par une adresse du tailnet et que `tailscaled` n'est pas encore
# prêt — personne ne réessaie, et `nofail` fait taire l'échec. C'est exactement ce qui
# s'était produit sur le Wyse : /mnt/nas-aurelien vide côté hôte pendant 26 jours.
#
# Même leçon que le commit 33c9f41 sur immich_vm : ne PAS utiliser RequiresMountsFor,
# qui annule le consommateur au lieu d'attendre.
#
# Usage : nfs-mount-wait <point-de-montage> [essais] [délai]

set -eu

MP="${1:?usage: nfs-mount-wait <mountpoint> [tries] [sleep]}"
TRIES="${2:-60}"
DELAY="${3:-5}"

# systemd-escape donne le vrai nom de l'unité (/mnt/nas-aurelien →
# mnt-nas\x2daurelien.mount). Le dériver évite d'écrire un \x2d à la main, qui ne
# survit pas aux couches de quoting.
UNIT="$(systemd-escape -p --suffix=mount "$MP")"

i=0
while [ "$i" -lt "$TRIES" ]; do
    if findmnt -M "$MP" >/dev/null 2>&1; then
        [ "$i" -gt 0 ] && echo "nfs-mount-wait: $MP monté après $((i * DELAY))s"
        exit 0
    fi
    systemctl start "$UNIT" >/dev/null 2>&1 || true
    sleep "$DELAY"
    i=$((i + 1))
done

echo "nfs-mount-wait: $MP TOUJOURS pas monté après $((TRIES * DELAY))s" >&2
exit 1
