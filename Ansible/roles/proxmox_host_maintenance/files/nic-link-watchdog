#!/bin/sh
# Watchdog du lien réseau : détecte le figement de la carte et réinitialise le lien.
# Consulter : journalctl -t nic-link-watchdog
# Déposé par Ansible — rôle proxmox_host_maintenance (ne pas éditer à la main).
#
# PROBLÈME TRAITÉ — bug « Detected Hardware Unit Hang » du driver e1000e sur
# contrôleur Intel i219 : la file de transmission de la carte se fige, mais le lien
# reste DÉCLARÉ UP. La machine devient sourde et muette sans qu'aucun compteur
# d'erreur ne bouge (carrier 0, errors 0, collisions 0) et sans que rien ne
# redémarre. Constaté le 2026-08-17 sur srv-run-proxmox : 30 minutes
# d'indisponibilité de l'hôte ET de ses deux VM, avec un uptime et des PID intacts.
# La panne a été résolue en débranchant/rebranchant le câble — autrement dit par un
# reset du lien, ce que fait ce script sans déplacement.
#
# Pourquoi le diagnostic est trompeur, et pourquoi ce script vise le bon symptôme :
# depuis la machine, ping renvoie « Destination Host Unreachable » émis par sa
# PROPRE adresse (échec de résolution ARP), et depuis le LAN l'entrée ARP reste
# « (incomplete) ». Rien n'accuse la carte, tout accuse le réseau.
#
# DEUX GARDES, pour que le remède ne devienne pas une source de pannes :
#   1. On n'agit QUE si le lien est déclaré « up ». Si operstate vaut « down »,
#      c'est un vrai débranchement : un down/up n'y changerait rien et masquerait
#      la cause réelle.
#   2. On n'agit qu'après plusieurs échecs consécutifs — SAUF si la signature
#      e1000e vient d'apparaître dans dmesg, où le diagnostic est certain et où
#      attendre ne fait que prolonger la coupure.
#
# Le compte de hangs est comparé à sa valeur du passage précédent plutôt qu'à une
# date : dmesg est un ring buffer et parser ses horodatages en sh est fragile. Une
# hausse du compte signifie « hang en cours ».

set -u

IFACE="${WATCHDOG_IFACE:-}"
TARGET="${WATCHDOG_TARGET:-}"
THRESHOLD="${WATCHDOG_FAIL_THRESHOLD:-3}"
COOLDOWN="${WATCHDOG_COOLDOWN:-600}"

TAG=nic-link-watchdog
STATE_FAILS="/run/${TAG}.fails"
STATE_HANGS="/run/${TAG}.hangs"
STATE_RESET="/run/${TAG}.last-reset"

log() { logger -t "$TAG" "$1"; }

[ -n "$IFACE" ] || {
    log "ERREUR: WATCHDOG_IFACE non défini, rien à surveiller"
    exit 1
}
[ -e "/sys/class/net/$IFACE/operstate" ] || {
    log "ERREUR: interface $IFACE inexistante"
    exit 1
}

# --- Garde 1 : un lien réellement down n'est pas notre cas d'usage -------------
LINK_STATE=$(cat "/sys/class/net/$IFACE/operstate" 2>/dev/null || echo unknown)
if [ "$LINK_STATE" != "up" ]; then
    log "lien $IFACE en état '$LINK_STATE' — défaut de lien réel, aucun reset tenté"
    echo 0 >"$STATE_FAILS"
    exit 0
fi

# Cible du test : la passerelle par défaut sauf consigne contraire. C'est un test
# de voisinage L2, sans dépendance à Internet — donc insensible à une panne FAI.
if [ -z "$TARGET" ]; then
    TARGET=$(/usr/sbin/ip route | awk '/^default/ {print $3; exit}')
fi
[ -n "$TARGET" ] || {
    log "ERREUR: aucune passerelle par défaut trouvée, et WATCHDOG_TARGET est vide"
    exit 1
}

# --- Signature e1000e ---------------------------------------------------------
hangs_now=$(dmesg 2>/dev/null | grep -c "Hardware Unit Hang")
hang_active=0
if [ -f "$STATE_HANGS" ]; then
    hangs_prev=$(cat "$STATE_HANGS" 2>/dev/null || echo 0)
    # Le ring buffer peut tourner et faire DIMINUER le compte : on ne conclut qu'à
    # la hausse, jamais à la baisse.
    if [ "$hangs_now" -gt "$hangs_prev" ]; then
        hang_active=1
    fi
else
    # PREMIER PASSAGE (au boot, /run est vide) : on amorce la référence sans rien
    # conclure. Sans ce cas, les hangs HISTORIQUES encore présents dans le ring
    # buffer seraient comparés à 0 et lus comme « hang en cours » — un reset serait
    # déclenché au premier échec de ping, y compris pendant l'établissement du
    # réseau au démarrage.
    hangs_prev="$hangs_now"
fi
echo "$hangs_now" >"$STATE_HANGS"

# Pas de -I : nic0 est esclave de vmbr0 et ne porte aucune adresse. On teste la
# connectivité effective par le routage normal, ce qui est bien ce qui compte.
if ping -c 3 -W 2 "$TARGET" >/dev/null 2>&1; then
    fails_prev=$(cat "$STATE_FAILS" 2>/dev/null || echo 0)
    if [ "$fails_prev" -gt 0 ]; then
        log "$TARGET de nouveau joignable après $fails_prev échec(s) consécutif(s)"
    fi
    echo 0 >"$STATE_FAILS"
    exit 0
fi

fails=$(($(cat "$STATE_FAILS" 2>/dev/null || echo 0) + 1))
echo "$fails" >"$STATE_FAILS"

# --- Garde 2 : seuil, court-circuité par la signature e1000e ------------------
if [ "$hang_active" -eq 1 ]; then
    log "ALERTE: $TARGET injoignable et signature e1000e « Hardware Unit Hang » en cours ($hangs_now occurrences cumulées) — reset immédiat de $IFACE"
elif [ "$fails" -lt "$THRESHOLD" ]; then
    log "$TARGET injoignable ($fails/$THRESHOLD), aucune signature e1000e — on attend"
    exit 0
else
    log "ALERTE: $TARGET injoignable $fails fois de suite (seuil $THRESHOLD) — reset de $IFACE"
fi

# --- Cooldown : ne pas réinitialiser en boucle si la cause est ailleurs -------
now=$(date +%s)
last=0
if [ -f "$STATE_RESET" ]; then
    last=$(cat "$STATE_RESET" 2>/dev/null || echo 0)
fi
if [ $((now - last)) -lt "$COOLDOWN" ]; then
    log "reset déjà tenté il y a $((now - last))s (cooldown ${COOLDOWN}s) — abandon, la cause est probablement ailleurs"
    exit 0
fi
echo "$now" >"$STATE_RESET"

log "reset du lien $IFACE (down/up) — coupure de quelques secondes, VM comprises"
/usr/sbin/ip link set "$IFACE" down
sleep 2
/usr/sbin/ip link set "$IFACE" up

# Laisser au bridge le temps de repasser son port en « forwarding » avant de
# conclure : PVE le fait en quelques secondes (blocking → forwarding dans dmesg).
sleep 8
if ping -c 3 -W 2 "$TARGET" >/dev/null 2>&1; then
    log "reset réussi: $TARGET de nouveau joignable"
    echo 0 >"$STATE_FAILS"
else
    log "ALERTE: $TARGET toujours injoignable après reset de $IFACE — intervention manuelle nécessaire"
fi
