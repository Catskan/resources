{#
  Géré par Ansible — roles/immich_proxy. Ne pas éditer à la main sur le NAS.
#}
# Reverse proxy TLS du NAS — généré par Ansible (roles/immich_proxy).
# Écoute sur {{ immich_proxy_listen_port }} ; la Freebox traduit WAN:443 → NAS:{{ immich_proxy_listen_port }}.

{
	# Pas d'API d'administration : le rôle recharge par « docker restart ».
	admin off

	# 80 et 443 appartiennent à nginx/DSM. On désactive la redirection HTTP→HTTPS
	# automatique de Caddy (elle voudrait ouvrir le 80) — le certificat étant
	# fourni à la main, aucune émission ACME n'est tentée non plus.
	auto_https disable_redirects
}

(tls_wildcard) {
	tls /certs/fullchain.pem /certs/privkey.key
}

(secure_headers) {
	header {
{% if immich_proxy_hsts_max_age | int > 0 %}
		Strict-Transport-Security "max-age={{ immich_proxy_hsts_max_age }}; includeSubDomains"
{% endif %}
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Immich -------------------------------------------------------------------
# Caddy n'impose aucune limite de taille de corps de requête ni de timeout de
# lecture par défaut : les uploads vidéo de l'app mobile passent sans réglage.
https://{{ immich_proxy_domain }}:{{ immich_proxy_listen_port }} {
	import tls_wildcard
	import secure_headers

	# Le matcher de réponse par défaut d'`encode` ne cible que text/*, JSON, JS,
	# wasm, SVG et polices — les JPEG/HEIC/vidéos d'Immich, déjà compressés, sont
	# exclus d'office. Rien à restreindre à la main, le CPU du NAS est préservé.
	encode zstd gzip

	# X-Forwarded-{For,Proto,Host} et les WebSockets sont gérés nativement.
	reverse_proxy {{ immich_proxy_backend }}
}

# --- Sonde de santé -----------------------------------------------------------
# En clair et bindée sur le loopback : sert uniquement au healthcheck Docker.
http://127.0.0.1:{{ immich_proxy_health_port }} {
	respond /healthz "ok" 200
	respond 404
}

# --- DSM ----------------------------------------------------------------------
# Conserve un accès DSM externe sous son propre nom, sur le même port public.
https://{{ immich_dsm_domain }}:{{ immich_proxy_listen_port }} {
	import tls_wildcard
	import secure_headers

	reverse_proxy https://{{ immich_dsm_backend }} {
		# `header_up Host` est INDISPENSABLE. Sans lui, nginx reçoit
		# `Host: {{ immich_dsm_backend }}`, ne trouve aucun server_name correspondant
		# et retombe sur son default_server — Web Station, pas DSM — qui répond 403
		# (« directory index of /var/services/web/ is forbidden »).
		# Avec l'ancien backend 5001 le default_server servait DSM, d'où un 200
		# trompeur : mais DSM bâtissait ses redirections sur ce Host et renvoyait le
		# navigateur vers https://127.0.0.1:5001, lui faisant perdre son cookie de
		# session → « Your login is invalid. Please sign-in again ».
		header_up Host {{ immich_dsm_domain }}

		# Le vhost 443 de DSM présente le certificat system_FQDN : on force le SNI
		# plutôt que de désactiver la vérification.
		transport http {
			tls
			tls_server_name {{ immich_dsm_domain }}
		}
	}
}
