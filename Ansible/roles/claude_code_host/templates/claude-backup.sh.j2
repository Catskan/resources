#!/usr/bin/env bash
# {{ ansible_managed }}
# Sauvegarde du backend Claude (loopback local du CT) -> NAS Synology, via rsync LOCAL sur un
# montage SSHFS. Cette approche contourne le wrapper rsync de Synology, qui refuse le
# rsync-over-SSH ("rsync service is not running") -> on ne lance jamais de rsync --server distant.
set -uo pipefail

SRC="{{ claude_backup_src }}"
SENTINEL="{{ claude_backup_sentinel }}"
MNT="{{ claude_backup_mnt }}"
NAS_SSH="{{ claude_backup_nas_ssh }}"
NAS_PORT="{{ claude_backup_nas_sshfs_port }}"
NAS_SUBDIR="{{ claude_backup_nas_subdir }}"
SSH_KEY="{{ claude_backup_ssh_key }}"
LOG="{{ claude_backup_log }}"
LOCK="{{ claude_backup_lock }}"
PROBE_TIMEOUT="{{ claude_backup_probe_timeout }}"
RSYNC_TIMEOUT="{{ claude_backup_rsync_timeout }}"

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

# Garde-fou 1 : la source doit etre montee ET non vide (sinon un --delete effacerait le backup).
if [ ! -d "$SRC/$SENTINEL" ] || [ -z "$(ls -A "$SRC/$SENTINEL" 2>/dev/null)" ]; then
  log "ABORT: source $SRC/$SENTINEL vide ou absente (loopback non monte ?)."
  exit 1
fi

# Verrou anti-recouvrement.
exec 9>"$LOCK"
if ! flock -n 9; then
  log "SKIP: une sauvegarde est deja en cours."
  exit 0
fi

# Garde-fou 0 : nettoyer un montage FUSE ZOMBIE avant toute autre operation.
# Apres une coupure, le point de montage peut rester en "Transport endpoint is not connected" :
# dans cet etat `mkdir`, `mountpoint` ET `sshfs` echouent tous les trois, et le script repart en
# erreur a chaque passage du cron sans jamais se reparer. Constate le 2026-07-28 : ~21 h sans
# aucune sauvegarde, derniere reussie le 27/07 a 18:47, et rien ne le signalait.
# Le demontage est inoffensif si rien n est monte (1er run, dossier absent) : on ignore l echec.
if ! timeout "$PROBE_TIMEOUT" ls -d "$MNT" >/dev/null 2>&1; then
  fusermount -uz "$MNT" 2>/dev/null || umount -l "$MNT" 2>/dev/null || true
fi

# Monte le NAS en SSHFS si necessaire (idempotent). Port SFTP 7258 (racine = /volume1/Aurelien).
mkdir -p "$MNT"

# `9>&-` ferme le descripteur du VERROU pour l enfant, et c est essentiel : sshfs se daemonise,
# donc il HERITE du fd 9 ouvert par `exec 9>"$LOCK"` et retient le flock aussi longtemps qu il vit.
# Tant que le script atteint son `fusermount -uz` final, le sshfs meurt et le verrou se libere.
# Mais si le script est interrompu avant (kill, timeout externe, coupure reseau, reboot), le sshfs
# survit et le verrou reste pris DEFINITIVEMENT : chaque passage du cron se contente alors d un
# "SKIP: une sauvegarde est deja en cours" et plus rien n est sauvegarde, sans qu aucune erreur ne
# le signale. Constate le 2026-07-28 : verrou retenu 2 h 30 par un sshfs orphelin, zero sauvegarde.
mount_sshfs() {
  sshfs "${NAS_SSH}:/" "$MNT" -p "$NAS_PORT" \
    -o "IdentityFile=$SSH_KEY,IdentitiesOnly=yes,reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,StrictHostKeyChecking=accept-new,uid=0,gid=0" 9>&-
}

if ! mountpoint -q "$MNT"; then
  mount_sshfs || { log "ERREUR: montage SSHFS de $MNT echoue."; exit 2; }
fi

# Garde-fou 2 : SONDER l'acces reel, pas seulement la presence du point de montage.
# Un sshfs MORT reste un mountpoint valide -> `mountpoint -q` reussit et ne detecte rien, alors
# que le moindre acces bloque indefiniment. C'est ce qui s'est produit le 2026-07-27 : rsync parti
# sur un sshfs mort, coince en etat D (fuse_readdir), verrou flock retenu ~13 h, en parallele d'un
# vzdump qui gelait le CT. On sonde donc avec timeout, et on remonte de force si c'est mort.
if ! timeout "$PROBE_TIMEOUT" ls "$MNT" >/dev/null 2>&1; then
  log "WARN: $MNT ne repond pas en ${PROBE_TIMEOUT}s (sshfs mort) -> demontage force + remontage."
  fusermount -uz "$MNT" 2>/dev/null || true
  mount_sshfs || { log "ERREUR: remontage SSHFS de $MNT echoue."; exit 2; }
  if ! timeout "$PROBE_TIMEOUT" ls "$MNT" >/dev/null 2>&1; then
    log "ABORT: $MNT toujours muet apres remontage -> rsync annule."
    fusermount -uz "$MNT" 2>/dev/null || true
    exit 4
  fi
fi

# Garde-fou 3 : la destination DOIT etre un point de montage, sinon rsync ecrirait sur le
# disque local du CT (faux backup + saturation). On refuse dans ce cas.
if ! mountpoint -q "$MNT"; then
  log "ABORT: $MNT non monte apres tentative -> rsync annule (protection disque local)."
  exit 3
fi
mkdir -p "$MNT/$NAS_SUBDIR"

RSYNC_OPTS=( {{ claude_backup_rsync_opts }} )
EXCLUDES=(
{% for ex in claude_backup_excludes %}
  --exclude={{ ex | quote }}
{% endfor %}
)

log "START rsync $SRC/ -> NAS:$NAS_SUBDIR/"
# `timeout` BORNE la duree : sans lui, un NAS qui cesse de repondre en cours de transfert laisse
# rsync bloque sans fin, verrou flock inclus -> plus aucune sauvegarde ne passe, et rien ne le
# signale (les executions suivantes se contentent d'un "SKIP"). --partial est deliberement absent
# des options : on ne veut pas conserver un transfert tronque.
# `9>&-` : meme raison que pour sshfs, par ceinture et bretelles. rsync ne se daemonise pas et il
# est borne par `timeout`, donc il ne peut pas retenir le verrou indefiniment — mais un `kill` du
# seul script parent le laisserait orphelin avec le fd 9 ouvert. Le fermer ne coute rien.
timeout "$RSYNC_TIMEOUT" rsync "${RSYNC_OPTS[@]}" "${EXCLUDES[@]}" "$SRC/" "$MNT/$NAS_SUBDIR/" >> "$LOG" 2>&1 9>&-
rc=$?

# Demontage propre (evite les stale mounts entre deux passages).
fusermount -uz "$MNT" 2>/dev/null || true

# rsync 23 (attrs/fichiers partiels: sockets, @eaDir...) et 24 (fichiers disparus pendant la
# copie: donnees vivantes) sont BENINS pour un backup -> succes avec warning.
case "$rc" in
  0)  log "OK rsync termine." ;;
  23) log "OK (warnings rc=23: certains fichiers/attrs ignores, ex. sockets/@eaDir)."; rc=0 ;;
  24) log "OK (warnings rc=24: des fichiers ont disparu pendant la copie)."; rc=0 ;;
  124) log "ERREUR: rsync tue par timeout apres ${RSYNC_TIMEOUT}s (NAS lent ou injoignable)." ;;
  *)  log "ERREUR rsync rc=$rc." ;;
esac
exit "$rc"
