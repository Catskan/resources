# {{ ansible_managed }}
# Source : roles/immich_vm/templates/immich.service.j2 — ne pas éditer sur la VM.
#
# Démarrage automatique d'Immich au boot de la VM.
#
# Pourquoi cette unité alors que le docker-compose porte déjà `restart: always` :
# `restart: always` fait repartir les conteneurs au démarrage du daemon Docker, mais
# ne dit rien de l'ordre par rapport au montage NFS des originaux.
#
# Le 17 août 2026, le montage a échoué 4 secondes après le boot (boot 20:29:08, échec
# 20:29:12). Le NAS était pourtant allumé et joignable : la faute est côté VM. Le
# réseau est géré par `ifupdown`, et `ifupdown-wait-online.service` était désactivé —
# sans lui, `network-online.target` est atteinte immédiatement et ne garantit rien. Le
# `_netdev` du fstab s'appuie sur cette cible : le montage part donc avant que
# l'interface soit utilisable, échoue, et faute d'option `retry` `mount.nfs` n'essaie
# jamais plus. `remote-fs.target` reste inactif, `immich_postgres` démarre (il n'a
# besoin que du SSD local) et `immich_server` non.
#
# Le vrai danger n'était pas l'absence de service — c'était qu'Immich démarre avec
# `/data` vide et considère les 149 Go d'originaux disparus.
#
# D'où les deux garde-fous :
#   RequiresMountsFor   → systemd monte {{ immich_vm_nfs_path }} avant, et abandonne sinon
#   ExecStartPre        → refus explicite de démarrer si `{{ immich_vm_nfs_sentinel }}/`
#                         n'est pas visible, ce qui attrape le point de montage vide

[Unit]
Description=Immich (docker compose)
Documentation=https://docs.immich.app
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor={{ immich_vm_nfs_path }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ immich_vm_repo_dir }}
# Garde-fou : ne jamais démarrer sur un point de montage vide.
ExecStartPre=/usr/bin/test -d {{ immich_vm_nfs_path }}/{{ immich_vm_nfs_sentinel }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
