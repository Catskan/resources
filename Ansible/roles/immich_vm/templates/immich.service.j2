# {{ ansible_managed }}
# Source : roles/immich_vm/templates/immich.service.j2 — ne pas éditer sur la VM.
#
# Démarrage automatique d'Immich au boot de la VM.
#
# Pourquoi cette unité alors que le docker-compose porte déjà `restart: always` :
# `restart: always` fait repartir les conteneurs au démarrage du daemon Docker, mais
# ne dit rien de l'ordre par rapport au montage NFS des originaux.
#
# Le 17 août 2026, le montage a échoué 4 secondes après le boot (boot 20:29:08, échec
# 20:29:12). Le NAS était pourtant allumé et joignable : la faute est côté VM. Le
# réseau est géré par `ifupdown`, et `ifupdown-wait-online.service` était désactivé —
# sans lui, `network-online.target` est atteinte immédiatement et ne garantit rien. Le
# `_netdev` du fstab s'appuie sur cette cible : le montage part donc avant que
# l'interface soit utilisable, échoue, et faute d'option `retry` `mount.nfs` n'essaie
# jamais plus. `remote-fs.target` reste inactif, `immich_postgres` démarre (il n'a
# besoin que du SSD local) et `immich_server` non.
#
# Le vrai danger n'était pas l'absence de service — c'était qu'Immich démarre avec
# `/data` vide et considère les 149 Go d'originaux disparus.
#
# D'où les deux garde-fous :
#   ExecStartPre (1)    → monte {{ immich_vm_nfs_path }}, en réessayant, car personne d'autre
#                         ne le refera : une unité .mount issue du fstab n'a pas de Restart=
#   ExecStartPre (2)    → refus explicite de démarrer si `{{ immich_vm_nfs_sentinel }}/`
#                         n'est pas visible, ce qui attrape le point de montage vide
#
# Pourquoi PAS de `RequiresMountsFor` : cette directive crée une dépendance dure, et
# systemd ANNULE alors le service dès que le montage échoue — « Dependency failed », sans
# qu'aucun ExecStartPre ne s'exécute. `After=` sans `Requires=` donne l'ordre sans ce veto.
#
# Vécu le 21 août, après un simple redémarrage de maintenance de l'hôte — arrêt propre à
# 20:35, retour à 20:39, le NAS n'ayant pas bougé : le montage a échoué à 20:39:17 sur
# « Network is unreachable », le service est resté `inactive` avec un `Result=success`
# trompeur, et l'instance est restée quinze heures hors service alors que l'attente
# ci-dessous aurait suffi. Ni coupure de courant ni panne : un reboot ordinaire suffit.

[Unit]
Description=Immich (docker compose)
Documentation=https://docs.immich.app
Requires=docker.service
After=docker.service network-online.target {{ immich_vm_nfs_unit }}
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ immich_vm_repo_dir }}

# Le montage NFS échoue régulièrement au boot sur « mount.nfs: Network is unreachable » :
# network-online.target est atteinte avant que la route par défaut soit posée, et
# l'option `retry` de mount.nfs ne couvre pas ce cas — elle traite les délais d'attente,
# pas l'absence de route, et abandonne aussitôt. Une unité .mount issue du fstab ne sait
# pas se relancer seule, d'où cette attente : jusqu'à 5 min, par essais de 5 s. Cinq
# minutes et non deux et demie, parce qu'un Synology qui redémarre après une coupure met
# plusieurs minutes à servir NFS, et que c'est précisément le scénario des soirs de
# multiprise coupée.
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 60 ]; do findmnt -M {{ immich_vm_nfs_path }} >/dev/null && exit 0; systemctl start {{ immich_vm_nfs_unit }} >/dev/null 2>&1; sleep 5; i=$((i+1)); done; exit 1'

# Garde-fou : ne jamais démarrer sur un point de montage vide.
ExecStartPre=/usr/bin/test -d {{ immich_vm_nfs_path }}/{{ immich_vm_nfs_sentinel }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
# 600 s pour laisser les 300 s d'attente du montage se dérouler sans être tronquées.
TimeoutStartSec=600
# Si le NAS n'est toujours pas là au bout de cinq minutes, réessayer plutôt qu'abandonner :
# c'est ce qui manquait le 21 août. `Restart=` sur un oneshot relance l'unité entière,
# donc l'attente du montage avec elle.
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
